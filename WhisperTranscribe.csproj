<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon></ApplicationIcon>
    <RootNamespace>WhisperTranscribe</RootNamespace>
    <AssemblyName>WhisperTranscribe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net.AllRuntimes" Version="1.9.0" />
    <PackageReference Include="xFFmpeg.NET" Version="7.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ネストプロジェクト(TestRunner)を自身のビルドに巻き込まない -->
    <Compile Remove="TestRunner\**"/>
    <Content Remove="TestRunner\**"/>
    <EmbeddedResource Remove="TestRunner\**"/>
    <None Remove="TestRunner\**"/>
    <Page Remove="TestRunner\**"/>
    <Resource Remove="TestRunner\**"/>
    <ApplicationDefinition Remove="TestRunner\**"/>
  </ItemGroup>

</Project>
