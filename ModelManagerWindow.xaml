<Window x:Class="WhisperTranscribe.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="モデル管理" Height="520" Width="780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap">
            HuggingFace から whisper.cpp 用 ggml モデルをダウンロード・削除します。
        </TextBlock>

        <DataGrid Grid.Row="1" x:Name="ModelsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="90"/>
                <DataGridTextColumn Header="状態" Binding="{Binding StatusText}" Width="120"/>
                <DataGridTextColumn Header="説明" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar Grid.Row="2" x:Name="DownloadProgress" Height="16" Margin="0,8,0,0" Minimum="0" Maximum="100"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="DownloadButton" Content="選択をダウンロード" Width="160" Margin="0,0,8,0" Click="DownloadButton_Click"/>
            <Button x:Name="DeleteButton" Content="選択を削除" Width="120" Margin="0,0,8,0" Click="DeleteButton_Click"/>
            <Button Content="閉じる" Width="100" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
