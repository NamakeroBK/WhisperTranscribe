<Window x:Class="WhisperTranscribe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper Transcribe" Height="720" Width="1100"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="16" FontWeight="Bold">
                Whisper Transcribe
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="モデル管理..." Width="120" Click="ManageModels_Click"/>
            <Button DockPanel.Dock="Right" Content="ffmpeg取得" Width="100" Margin="0,0,8,0" Click="InstallFfmpeg_Click"/>
        </DockPanel>

        <!-- ファイル一覧 -->
        <GroupBox Grid.Row="1" Header="入力ファイル (ドラッグ&amp;ドロップ可・上から順に連結)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="FilesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="250"/>
                        <DataGridTextColumn Header="長さ" Binding="{Binding DurationText}" Width="80"/>
                        <DataGridTextColumn Header="形式" Binding="{Binding FormatSummary}" Width="220"/>
                        <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="140"/>
                        <DataGridTextColumn Header="パス" Binding="{Binding FullPath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="追加..." Width="80" Margin="0,0,6,0" Click="AddFiles_Click"/>
                    <Button Content="フォルダ追加..." Width="120" Margin="0,0,6,0" Click="AddFolder_Click"/>
                    <Button Content="上へ" Width="60" Margin="0,0,6,0" Click="MoveUp_Click"/>
                    <Button Content="下へ" Width="60" Margin="0,0,6,0" Click="MoveDown_Click"/>
                    <Button Content="削除" Width="60" Margin="0,0,6,0" Click="Remove_Click"/>
                    <Button Content="全て削除" Width="80" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 設定パネル -->
        <GroupBox Grid.Row="2" Header="設定" Margin="0,8,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4">モデル:</TextBlock>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelCombo" Margin="0,0,16,4" DisplayMemberPath="DisplayName"/>

                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,4">言語:</TextBlock>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="LanguageCombo" Margin="0,0,16,4"/>

                <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,4">出力フォルダ:</TextBlock>
                <DockPanel Grid.Row="0" Grid.Column="5" LastChildFill="True" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="..." Width="30" Click="BrowseOutDir_Click"/>
                    <TextBox x:Name="OutDirBox"/>
                </DockPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="NormalizeCheck" Content="ラウドネス正規化" IsChecked="True" Margin="0,0,12,0"/>
                    <CheckBox x:Name="HighQualityCheck" Content="高品質モード (beam=10)" ToolTip="精度向上・処理速度は約2倍遅くなります"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="OutTxt" Content=".txt" IsChecked="True" Margin="0,0,12,0"/>
                    <CheckBox x:Name="OutSrt" Content=".srt" IsChecked="True" Margin="0,0,12,0"/>
                    <CheckBox x:Name="OutVtt" Content=".vtt"/>
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="OutNameBox" Margin="0,4,0,0" ToolTip="出力ファイル名 (拡張子なし)"/>
            </Grid>
        </GroupBox>

        <!-- 進捗・実行ボタン -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="MainProgress" Height="24" Minimum="0" Maximum="100"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="StartButton" Content="文字起こし開始" Width="140" Click="Start_Click"/>
                <Button x:Name="CancelButton" Content="中止" Width="80" Margin="6,0,0,0" Click="Cancel_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- ログ -->
        <GroupBox Grid.Row="4" Header="ログ" Margin="0,8,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     TextWrapping="NoWrap"/>
        </GroupBox>
    </Grid>
</Window>
